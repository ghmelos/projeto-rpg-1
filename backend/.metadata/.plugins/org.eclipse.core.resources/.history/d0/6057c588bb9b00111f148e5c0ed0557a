CREATE DATABASE IF NOT EXISTS db_rpg;

USE db_rpg;

CREATE TABLE IF NOT EXISTS tb_personagem (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(255) NOT NULL,
    classe VARCHAR(255) NOT NULL,
    nivel INT NOT NULL,
    atributo VARCHAR(255) NOT NULL
);

